# Copia este archivo como .env.local (desarrollo) y configura las mismas variables en Vercel.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (en Vercel: https://tu-proyecto.vercel.app o tu dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marca y dominio institucional (el dominio también está en la función SQL public.institutional_domain())
NEXT_PUBLIC_BRAND=TalentoMDD
NEXT_PUBLIC_UNIVERSITY=UNAMAD
NEXT_PUBLIC_INSTITUTIONAL_DOMAIN=unamad.edu.pe

# Muestra el botón "Continuar con Google" (activa antes el proveedor Google en Supabase → Authentication)
NEXT_PUBLIC_ENABLE_GOOGLE=false
